<div class="pta-sheet-body flexcol">
    <header class="pta-id-card pta-actor-sheet-header pta-sheet-header sheet-header pta-id-card--redesign" style="--pta-trainer-bg-color: {{#if flags.pta.trainerColorBg}}{{flags.pta.trainerColorBg}}{{else}}#102047{{/if}}; --pta-trainer-border-color: {{#if flags.pta.trainerColorBorder}}{{flags.pta.trainerColorBorder}}{{else}}#ffffff{{/if}}; --pta-trainer-id-color: {{#if flags.pta.trainerColorBg}}{{flags.pta.trainerColorBg}}{{else}}#102047{{/if}};">
        <div class="card-badge flexrow flex-between">
            <span class="card-brand">TRAINER CARD</span>
            <span class="card-code">ID {{document.id}}</span>
        </div>
        <div class="flexrow flex-gap-s card-main">
            <img class="trainer-photo flex0" title="{{document.type}} " data-action="editImage" src="{{document.img}}">
            <div class="flexcol flex-gap-s card-info">
                <div class="card-title-row flexrow flex-align-end">
                    <input class="pta-font-xl pta-id-name" type="text" value="{{document.name}}" name="name">
                </div>
                <div class="card-meta flexrow flex-wrap flex-gap-s">
                    {{systemFieldGroup system 'honours'}}
                    {{systemFieldGroup system 'origin'}}
                </div>
                <div class="trainer-card-controls compact flexrow flex-gap-s flex-align-center">
                    <label class="color-picker-button" title="Background color">
                        <span>🎨</span>
                        <input type="color" name="flags.pta.trainerColorBg" value="{{#if flags.pta.trainerColorBg}}{{flags.pta.trainerColorBg}}{{else}}#102047{{/if}}">
                    </label>
                    <label class="color-picker-button" title="Trainer photo border">
                        <span>🎨</span>
                        <input type="color" name="flags.pta.trainerColorBorder" value="{{#if flags.pta.trainerColorBorder}}{{flags.pta.trainerColorBorder}}{{else}}#ffffff{{/if}}">
                    </label>
                </div>
                <div class="progress-bar compact-progress">
                    <label>Health</label>
                    <div class="wrapper">
                        <div class="bar {{#if (lt (divide system.hp.value system.hp.total) 0.33)}}red{{else}}green{{/if}}" style="width: {{multiply 100 (divide system.hp.value system.hp.total)}}%;">
                        </div>
                        <div class="pta-s flexrow card-health-value">
                            {{systemFieldInput system 'hp.value'}}
                            /
                            {{#if isEditMode}}
                                {{systemFieldInput system 'hp.max'}}
                            {{else}}
                                <div class="text-center">{{system.hp.total}}</div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
            <div class="pta-card-classes flexcol flex-gap-s">
                <div class="class-panel">
                    <div class="class-label">Classes</div>
                    <div class="flexcol flex-gap-s">
                        <div class="class-row flexrow flex-gap-s">
                            <input class="flex0 text-center" style="min-width: 2rem;" type="number" disabled value="{{system.class_1.level}}">
                            <input type="text" name="system.class_1.label" value="{{system.class_1.label}}" placeholder="First Class">
                        </div>
                        <div class="class-row flexrow flex-gap-s">
                            <input class="flex0 text-center" style="min-width: 2rem;" type="number" disabled value="{{system.class_2.level}}">
                            <input type="text" name="system.class_2.label" value="{{system.class_2.label}}" placeholder="Second Class">
                        </div>
                        <div class="class-row flexrow flex-gap-s">
                            <input class="flex0 text-center" style="min-width: 2rem;" type="number" disabled value="{{system.class_3.level}}">
                            <input type="text" name="system.class_3.label" value="{{system.class_3.label}}" placeholder="Third Class">
                        </div>
                        <div class="class-row flexrow flex-gap-s">
                            <input class="flex0 text-center" style="min-width: 2rem;" type="number" disabled value="{{system.class_4.level}}">
                            <input type="text" name="system.class_4.label" value="{{system.class_4.label}}" placeholder="Fourth Class">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="pta-trainer-pokemon-strip">
            <div class="strip-header flexrow flex-between flex-align-center">
                <span class="strip-title">Trainer Pokémon</span>
                <span class="strip-note">Active and boxed party at a glance</span>
            </div>
            <div class="strip-list flexrow flex-gap-s">
                {{#each pokemon as |pokemon key|}}
                    {{#if (not pokemon.missing)}}
                        <div class="strip-item {{#if pokemon.active}}active{{/if}}" title="{{pokemon.name}}">
                            <img src="{{pokemon.img}}" alt="{{pokemon.name}}">
                            <div class="strip-name"><span>{{pokemon.name}}</span></div>
                        </div>
                    {{/if}}
                {{/each}}
            </div>
        </div>
    </header>
    {{> "pta.tabs-content"}}
</div>