{{!-- Skills grid (compact) --}}
<div class="flex-gap-s pta-skills-grid" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; align-items: center;">
    {{#each skills as | skill key |}}
        <div class="pta-skill pta-s" data-pta-skill="{{key}}" data-pta-stat="{{skill.stat}}">
            <a class="pta-talent" data-action="trainTalent">
                <i class="fa-{{#if (eq skill.talent 0)}}regular{{else}}solid{{/if}} fa-circle{{#if (eq skill.talent 1)}}-half-stroke{{/if}}"></i>
            </a>
            <a class="pta-skill-label" data-action="roll" data-roll="1d20+{{skill.total}}" data-roll-msg="{{skillLabel key}}">
                <span class="skill-score">{{numberFormat skill.total sign=true}}</span>
                <span class="skill-name">{{skillLabel key}}</span>
            </a>
            <input type="number" value="{{skill.bonus}}" name="system.skills.{{key}}.bonus" class="flex0" style="width: 2.2em; flex: 0; height: 1.6em; margin-left: 6px;">
        </div>
    {{/each}}
</div>